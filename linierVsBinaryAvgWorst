
#include <stdio.h>

int linear(int a[],int n,int key){
    int i,c=0;
    for(i=0;i<n;i++){
        c++;
        if(a[i]==key) break;
    }
    return c;
}

int binary(int a[],int n,int key){
    int l=0,r=n-1,m,c=0;
    while(l<=r){
        c++;
        m=(l+r)/2;
        if(a[m]==key) break;
        if(a[m]<key) l=m+1;
        else r=m-1;
    }
    return c;
}

int main(){
    int a[80],n,i;
    double la,ba;
    printf("Size LinAvg BinAvg LinWorst BinWorst\n");

    for(n=20;n<=80;n+=10){
        for(i=0;i<n;i++) a[i]=i+1;

        la=ba=0;
        for(i=0;i<n;i++){
            la+=linear(a,n,a[i]);
            ba+=binary(a,n,a[i]);
        }

        printf("%d %.2f %.2f %d %d\n",
            n,la/n,ba/n,
            linear(a,n,-1),binary(a,n,-1));
    }
    return 0;
}

